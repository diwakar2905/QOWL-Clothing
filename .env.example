# ─────────────────────────────────────────────────────────────────────────────
# QOWL environment configuration. Copy to .env (local) or set in your host.
# NEVER commit real secrets. Values marked REQUIRED must be set.
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3000                 # REQUIRED. Public base URL (https://… in production)
DATABASE_URL=postgresql://qowl:password@localhost:5432/qowl_dev   # REQUIRED
DATABASE_POOL_SIZE=10                         # Use 3 on Vercel/serverless
DATABASE_URL_UNPOOLED=                        # Optional. Direct (non-pooler) URL used only by migrations, e.g. Neon's unpooled URL
SESSION_SECRET=                               # REQUIRED. ≥32 random chars: openssl rand -base64 48
CRON_SECRET=                                  # REQUIRED. ≥16 chars; Bearer token for POST /api/cron/jobs
TRUST_PROXY=false                             # true behind a trusted proxy/CDN (uses X-Forwarded-For for rate limits)
RESERVATION_TTL_MINUTES=30                    # How long checkout holds stock while awaiting payment
LOG_LEVEL=info

# ── Google sign-in (optional) ───────────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorised redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Payments ────────────────────────────────────────────────────────────────
# razorpay (production) | mock (development/testing only; refused in production)
PAYMENT_PROVIDER=mock
MOCK_PAYMENT_SECRET=dev-mock-secret
RAZORPAY_KEY_ID=                              # rzp_test_… (sandbox) or rzp_live_… (production)
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=                      # Set the same secret on the Razorpay webhook (URL: /api/webhooks/payments/razorpay)

# ── Shipping ────────────────────────────────────────────────────────────────
# manual (store rules + admin-entered AWBs) | shiprocket | mock (dev only)
SHIPPING_PROVIDER=manual
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_PICKUP_LOCATION=Primary
SHIPROCKET_PICKUP_PINCODE=
SHIPROCKET_WEBHOOK_TOKEN=                     # Sent by Shiprocket as x-api-key to /api/webhooks/shipping/shiprocket

# ── Email ───────────────────────────────────────────────────────────────────
EMAIL_PROVIDER=console                        # console (logs only) | resend
RESEND_API_KEY=
EMAIL_FROM="QOWL <orders@your-verified-domain.in>"
EMAIL_REPLY_TO=
SMS_PROVIDER=none                             # SMS/WhatsApp not wired yet (needs DLT templates + consent)

# ── Media storage ───────────────────────────────────────────────────────────
STORAGE_DRIVER=local                          # local (dev / single persistent host) | s3
LOCAL_STORAGE_DIR=./storage/uploads
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=                                  # optional, for R2/MinIO/etc.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
MEDIA_PUBLIC_BASE_URL=                        # CDN/public bucket URL, e.g. https://media.qowl.in

# ── Seeding (development only) ──────────────────────────────────────────────
SEED_FIXTURES=false                           # true loads DEV fixtures (refused when NODE_ENV=production)
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
NEXT_TELEMETRY_DISABLED=1
